            steps {
                nexusArtifactUploader(
                    nexusVersion: 'nexus3',
                    protocol: 'http',
                    nexusUrl: '13.38.32.159:8081',
                    groupId: 'com.netflix',
                    version: '1.0',
                    repository: 'maven-releases',
                    credentialsId: 'nexus-creds',
                    artifacts: [
                        [
                            artifactId: 'netflix',
                            classifier: '',
                            file: 'target/netflix.war',
                            type: 'war'
                        ]
                    ]
                )
            }
        }
    }
}



    
